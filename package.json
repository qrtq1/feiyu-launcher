{
  "name": "feiyu-launcher",
  "version": "0.3.0",
  "description": "肥鱼启动器 - 一个从零写起的 Minecraft 启动器",
  "main": "./out/main/index.js",
  "author": "feiyu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "setup:electron": "node scripts/fetch-electron.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import ./tests/stub/register.mjs --test \"tests/**/*.test.mts\"",
    "pack": "node scripts/build.mjs && electron-builder --dir",
    "pack:green": "node scripts/build.mjs && electron-builder --dir && node scripts/greenify.mjs",
    "pack:sfx": "node scripts/build.mjs && electron-builder --dir && node scripts/build-sfx.mjs",
    "dist": "node scripts/build.mjs && electron-builder",
    "dist:ia32": "node scripts/fetch-electron.mjs --arch=ia32 && node scripts/build.mjs && node node_modules/electron-builder/out/cli/cli.js --win --config electron-builder.ia32.yml",
    "dist:linux": "node scripts/fetch-electron.mjs --platform=linux --arch=x64 && node scripts/build.mjs && node node_modules/electron-builder/out/cli/cli.js --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "rollup": "^4.68.6",
    "tslib": "^2.9.1",
    "typescript": "^5.9.0"
  }
}
